@model TASK_2.ViewModels.CourseDetailsViewModel

@{
    ViewData["Title"] = "Course Details";
}

<h1>@Model.Name</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <p><strong>Id:</strong> @Model.Id</p>
        <p><strong>Min Degree:</strong> @Model.MinDegree</p>
        <p><strong>Department:</strong> @Model.DepartmentName</p>
        <p><strong>Instructor:</strong> @(Model.InstructorName ?? "No instructor assigned yet")</p>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary btn-sm mt-3">&larr; Back</a>