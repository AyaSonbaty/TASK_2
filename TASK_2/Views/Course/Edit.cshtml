@model DataAccessLayer.Models.Course

@{
    ViewData["Title"] = "Edit Course";
}

<h1>Edit Course</h1>

<form asp-action="Edit" method="post" style="max-width: 500px;">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Course Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Min Degree</label>
        <input asp-for="MinDegree" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Department</label>
        <select asp-for="DepartmentId" class="form-control">
            @foreach (var dept in ViewBag.Departments)
            {
                <option value="@dept.Id">@dept.Name</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Instructor</label>
        <select asp-for="InstructorId" class="form-control">
            @foreach (var inst in ViewBag.Instructors)
            {
                <option value="@inst.Id">@inst.Name</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}