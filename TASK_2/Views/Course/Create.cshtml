@model TASK_2.ViewModels.CourseCreateViewModel

@{
    ViewData["Title"] = "Add Course";
}

<h1>Add New Course</h1>

<form asp-action="Create" method="post" style="max-width: 500px;">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label>Course Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Min Degree</label>
        <input asp-for="MinDegree" class="form-control" />
        <span asp-validation-for="MinDegree" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Department</label>
        <select asp-for="DepartmentId" asp-items="@ViewBag.Departments" class="form-control">
            <option value="">-- Select Department --</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Instructor</label>
        <select asp-for="InstructorId" asp-items="@ViewBag.Instructors" class="form-control">
            <option value="">-- Select Instructor --</option>
        </select>
        <span asp-validation-for="InstructorId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}