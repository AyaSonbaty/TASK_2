@model DataAccessLayer.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>

@if (ViewBag.BlockedMessage != null)
{
    <div class="alert alert-danger">@ViewBag.BlockedMessage</div>
}
else
{
    <div class="alert alert-warning">Are you sure you want to delete this course? This cannot be undone.</div>
}

<div class="card mb-4" style="max-width: 500px;">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text"><strong>Min Degree:</strong> @Model.MinDegree</p>
        <p class="card-text"><strong>Department:</strong> @Model.Department?.Name</p>
        <p class="card-text"><strong>Instructor:</strong> @(Model.Instructor?.Name ?? "No instructor assigned")</p>
    </div>
</div>

@if (ViewBag.BlockedMessage == null)
{
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="confirm" value="true" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
}
else
{
    <a asp-action="Index" class="btn btn-secondary">Back to Courses</a>
}