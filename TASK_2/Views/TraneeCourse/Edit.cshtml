@model DataAccessLayer.Models.TraneeCourse

@{
    ViewData["Title"] = "Edit Grade";
}

<h1>Edit Trainee Registration</h1>

<form asp-action="Edit" method="post" style="max-width: 500px;">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <input type="hidden" asp-for="TraneeId" />
    <input type="hidden" asp-for="CourseId" />

    <div class="mb-3">
        <label>Trainee</label>
        <input value="@Model.Tranee?.Name" class="form-control" disabled />
    </div>

    <div class="mb-3">
        <label>Course</label>
        <input value="@Model.Course?.Name" class="form-control" disabled />
    </div>

    <div class="mb-3">
        <label>Grade</label>
        <input asp-for="Grade" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}