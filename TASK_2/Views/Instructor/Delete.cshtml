@model DataAccessLayer.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";
}

<h1>Delete Instructor</h1>

@if (ViewBag.BlockedMessage != null)
{
    <div class="alert alert-danger">@ViewBag.BlockedMessage</div>
}
else
{
    <div class="alert alert-warning">Are you sure you want to delete this instructor? This cannot be undone.</div>
}

<div class="card mb-4" style="max-width: 500px;">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text"><strong>Address:</strong> @Model.Address</p>
        <p class="card-text"><strong>Department:</strong> @Model.Department?.Name</p>
    </div>
</div>

@if (ViewBag.BlockedMessage == null)
{
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="confirm" value="true" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="ByDepartment" asp-route-id="@Model.DepartmentId" class="btn btn-secondary">Cancel</a>
    </form>
}
else
{
    <a asp-action="ByDepartment" asp-route-id="@Model.DepartmentId" class="btn btn-secondary">Back</a>
}