@model List<DataAccessLayer.Models.Instructor>

@{
    ViewData["Title"] = "Instructors";
    string deptName = Model.Any() ? Model[0].Department.Name : "";
}

<h1>Instructors in @deptName</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<a asp-controller="Department" asp-action="Index" class="btn btn-secondary btn-sm mb-3">
    &larr; Back to Departments
</a>
<a asp-controller="Instructor" asp-action="Create" class="btn btn-success btn-sm mb-3">+ Add Instructor</a>

@if (!Model.Any())
{
    <p>No instructors found in this department.</p>
}
else
{
    <table class="table table-hover table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Address</th>
                <th>Salary</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var instructor in Model)
            {
                <tr>
                    <td>@instructor.Id</td>
                    <td>@instructor.Name</td>
                    <td>@instructor.Address</td>
                    <td>@instructor.Salary</td>
                    <td>
                        <a asp-controller="Instructor" asp-action="Details" asp-route-id="@instructor.Id"
                           class="btn btn-info btn-sm">
                            Details
                        </a>
                        <a asp-controller="Instructor" asp-action="Edit" asp-route-id="@instructor.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>
                        <a asp-controller="Instructor" asp-action="Delete" asp-route-id="@instructor.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}