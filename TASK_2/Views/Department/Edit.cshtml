@model TASK_2.ViewModels.DepartmentViewModel
@{
    ViewData["Title"] = "Edit Department";
}

<h1>Edit Department</h1>

<form asp-action="Edit" method="post" style="max-width: 500px;">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Department Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Manager (must be an instructor in this department)</label>
        <select asp-for="ManagerId" class="form-control">
            <option value="">-- No Manager --</option>
            @if (ViewBag.Instructors != null)
            {
                @foreach (var instructor in (List<DataAccessLayer.Models.Instructor>)ViewBag.Instructors)
                {
                    <option value="@instructor.Id">@instructor.Name</option>
                }
            }
        </select>
        <span asp-validation-for="ManagerId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}