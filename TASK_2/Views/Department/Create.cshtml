@model TASK_2.ViewModels.DepartmentViewModel

@{
    ViewData["Title"] = "Add Department";
}

<h1>Add New Department</h1>

<form asp-action="Create" method="post" style="max-width: 500px;">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label>Department Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Manager (must be an existing instructor)</label>
        <select asp-for="ManagerId" class="form-control">
            <option value="">-- No Manager --</option>
            @foreach (var instructor in (List<DataAccessLayer.Models.Instructor>)ViewBag.Instructors)
            {
                <option value="@instructor.Id">@instructor.Name</option>
            }
        </select>
        <span asp-validation-for="ManagerId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}